{:tasks
 {:init
  (do
    (defn label-line
      "A profile's label, e.g. `=== Squint 0.15.212 | Node with jsdom globals`.
       SGR styling: `marker` and `|` dim, the dialect bold, the row plain.
       Plain text when NO_COLOR is set."
      [marker dialect row]
      (let [sgr (fn [code s]
                  (if (System/getenv "NO_COLOR") s (str "\u001b[" code "m" s "\u001b[0m")))]
        (str (sgr 2 marker) " " (sgr 1 dialect) " " (sgr 2 "|") " " row)))

    (defn run-labeled
      "Runs a test command under a label line, e.g.
       `=== Squint 0.15.212 | Node with jsdom globals`, and prints its
       output (stdout, then stderr) indented, without blank lines. Fails the
       task with the command's exit code when it fails, like `shell`."
      [dialect row opts & cmd]
      (println (label-line "===" dialect row))
      (let [{:keys [out err exit]}
            (apply shell (merge {:out :string :err :string :continue true} opts) cmd)]
        (doseq [line  (clojure.string/split-lines (str out err))
                :when (not (clojure.string/blank? line))]
          (println (str "    " line)))
        (println)
        (when-not (zero? exit)
          (throw (ex-info (str dialect " | " row " failed") {:babashka/exit exit})))))

    ;; Environment for the runs without globalThis. With NODE_USE_ENV_PROXY
    ;; set, Node sets up its HTTP proxy after `-r` preloads run, and that
    ;; setup reads globalThis, so Node itself crashes before the tests start.
    (def no-globalthis-env
      (dissoc (into {} (System/getenv)) "NODE_USE_ENV_PROXY"))

    (defn run-node-rows
      "Runs a compiled test entrypoint on Node: plain, with jsdom globals
       stubbed in and, unless `no-globalthis?` is false, with globalThis
       deleted. Cherry and Clojurific skip the last run, because their own
       runtimes need globalThis. `dialect` labels each run."
      ([dialect test-js] (run-node-rows dialect test-js true))
      ([dialect test-js no-globalthis?]
       (run-labeled dialect "Node" {}
                    "node" test-js)
       (run-labeled dialect "Node with jsdom globals" {:extra-env {"JS_RUNTIME_DETECT_ENV" "jsdom-node"}}
                    "node" "-r" "./test/stubs/jsdom.cjs" test-js)
       (when no-globalthis?
         (run-labeled dialect "Node without globalThis" {:env no-globalthis-env}
                      "node" "-r" "./test/stubs/no-globalthis.cjs" test-js))))

    (defn run-advanced
      "Compiles the tests with :advanced using the ClojureScript from `alias`,
       then runs them on Node."
      [dialect alias out-dir]
      (clojure (str "-M:" alias) "script/build_advanced.clj" out-dir)
      (run-node-rows dialect (str out-dir "/main.js")))

    (defn run-esm-dialect
      "Compiles src and test with the Squint or Cherry CLI from npm `pkg`
       (name@version), installs the same package next to the output for the
       runtime the compiled modules import, then runs the tests on Node."
      [dialect pkg out-dir no-globalthis?]
      (shell "npx" "--yes" pkg "compile" "--paths" "src" "--paths" "test" "--output-dir" out-dir)
      (shell "npm" "install" "--no-save" "--no-package-lock" "--silent" "--prefix" out-dir pkg)
      (run-node-rows dialect (str out-dir "/js_runtime_detection/runner.mjs") no-globalthis?)))

  ;; Test
  ;; ---------------------------------------------------------------------------
  test
  {:doc  "Run the test suite on Node under nbb. Same as test:nbb."
   :depends [test:nbb]}

  test:nbb
  {:doc  "Run the test suite on Node under nbb, plain and with jsdom globals. Requires Node.js and npx (fetches nbb on first run)."
   :task (let [args ["npx" "--yes" "nbb@1.6.214" "-cp" "src:test" "test/js_runtime_detection/runner.cljs"]]
           (apply run-labeled "nbb 1.6.214" "Node" {} args)
           (apply run-labeled "nbb 1.6.214" "Node with jsdom globals"
                  {:extra-env {"JS_RUNTIME_DETECT_ENV" "jsdom-node"
                               "NODE_OPTIONS"          "-r ./test/stubs/jsdom.cjs"}}
                  args))}

  test:squint
  {:doc  "Compile the tests with Squint and run them on Node: plain, with jsdom globals, and without globalThis. Requires Node.js and npx."
   :task (run-esm-dialect "Squint 0.15.212" "squint-cljs@0.15.212" "target/squint" true)}

  test:cherry
  {:doc  "Compile the tests with Cherry and run them on Node: plain and with jsdom globals. Requires Node.js and npx."
   :task (run-esm-dialect "Cherry 0.6.38" "cherry-cljs@0.6.38" "target/cherry" false)}

  test:clojurific
  {:doc  "Compile the tests with Clojurific and run them on Node: plain and with jsdom globals. Requires Java 17 or newer."
   :task (do (clojure "-M:clojurific" "-m" "cljf.esm" "build"
                      (str "{:test-runner {:ns js-runtime-detection.clojurific-runner"
                           " :ns-regexp \"-test$\" :runner cljf.esm.node-test/run}"
                           " :output-dir \"target/clojurific\"}"))
             (run-node-rows "Clojurific 0.12.15" "target/clojurific/js_runtime_detection/clojurific_runner.js" false))}

  test:advanced
  {:doc  "Compile the tests with :advanced on the latest ClojureScript and run them on Node: plain, with jsdom globals, and without globalThis. Catches property renaming that dev builds don't show."
   :task (run-advanced "ClojureScript 1.12.145, :advanced" "cljs-latest" "target/cljs-latest")}

  test:compat
  {:doc  "Compile the tests with :advanced on the oldest supported ClojureScript (1.9.854) and run them on Node: plain, with jsdom globals, and without globalThis."
   :task (run-advanced "ClojureScript 1.9.854, :advanced" "cljs-1.9" "target/cljs-1.9.854")}

  test:cloudflare
  {:doc      "Compile a probe with :advanced and run it in workerd (Cloudflare's Workers runtime) through Miniflare, with and without nodejs_compat. Optional: skipped unless Miniflare is installed in test/cloudflare."
   :requires ([babashka.fs :as fs])
   :task     (if (fs/exists? "test/cloudflare/node_modules/miniflare")
               (do (clojure "-M:cljs-latest" "script/build_advanced.clj" "target/cloudflare-probe"
                            "js-runtime-detection.worker-probe" "browser")
                   (run-labeled "ClojureScript 1.12.145, :advanced" "Cloudflare Workers (workerd via Miniflare)" {}
                                "node" "test/cloudflare/run.mjs" "target/cloudflare-probe/main.js"))
               (println (str "SKIPPED test:cloudflare: Miniflare is not installed. To enable it, run:\n"
                             "  npm install --no-save --prefix test/cloudflare miniflare@4.20260730.0")))}

  test:all
  {:doc      "Run every test task. test:cloudflare skips if Miniflare is not installed."
   :requires ([babashka.fs :as fs])
   :task
   (let [cloudflare? (fs/exists? "test/cloudflare/node_modules/miniflare")
         ;; [task labels], in run order. Keep the labels in step with the
         ;; ones each task prints.
         plan [['test:nbb        ["nbb 1.6.214 | Node"
                                  "nbb 1.6.214 | Node with jsdom globals"]]
               ['test:advanced   ["ClojureScript 1.12.145, :advanced | Node"
                                  "ClojureScript 1.12.145, :advanced | Node with jsdom globals"
                                  "ClojureScript 1.12.145, :advanced | Node without globalThis"]]
               ['test:compat     ["ClojureScript 1.9.854, :advanced | Node"
                                  "ClojureScript 1.9.854, :advanced | Node with jsdom globals"
                                  "ClojureScript 1.9.854, :advanced | Node without globalThis"]]
               ['test:cloudflare [(str "ClojureScript 1.12.145, :advanced | Cloudflare Workers (workerd via Miniflare)"
                                       (when-not cloudflare? " (skipped, Miniflare is not installed)"))]]
               ['test:squint     ["Squint 0.15.212 | Node"
                                  "Squint 0.15.212 | Node with jsdom globals"
                                  "Squint 0.15.212 | Node without globalThis"]]
               ['test:cherry     ["Cherry 0.6.38 | Node"
                                  "Cherry 0.6.38 | Node with jsdom globals"]]
               ['test:clojurific ["Clojurific 0.12.15 | Node"
                                  "Clojurific 0.12.15 | Node with jsdom globals"]]]]
     (println "Preparing to test js-runtime-detection on the following profiles:")
     (doseq [[_ labels] plan
             label      labels]
       (println (apply label-line "---" (clojure.string/split label (re-pattern " [|] ") 2))))
     (println)
     (doseq [[task _] plan]
       (run task)))}

  ;; Build
  ;; ---------------------------------------------------------------------------
  ci
  {:doc     "Run the CI pipeline of tests and build the JAR."
   :depends [test:all]
   :task    (clojure "-T:build" "jar")}
  
  deploy
  {:doc      "Build the JAR and deploy it to Clojars. Requires CLOJARS_USERNAME and CLOJARS_PASSWORD (a deploy token) in the environment, or a with-clojars-creds command on your PATH that supplies them."
   :requires ([babashka.fs :as fs])
   :task     (do (clojure "-T:build" "jar")
                 (if (fs/which "with-clojars-creds")
                   (shell "with-clojars-creds" "clojure" "-T:build" "deploy")
                   (clojure "-T:build" "deploy")))}

  ci:deploy
  {:doc     "Run the tests, then build and deploy the JAR to Clojars."
   :depends [test:all]
   :task    (run 'deploy)}

  install
  {:doc     "Install the JAR locally (build via ci)."
   :depends [ci]
   :task    (clojure "-T:build" "install")}

  ;; Docs
  ;; ---------------------------------------------------------------------------
  docs:readme
  {:doc      "Update the version numbers in README.md to match the latest tag (v0.2.0 -> 0.2.0). Leaves README.md alone if there are no tags yet."
   :requires ([babashka.process :as p]
              [clojure.string :as str])
   :task
   (let [tag (-> (p/shell {:out :string :err :string :continue true}
                          "git describe --tags --abbrev=0")
                 :out
                 str/trim
                 not-empty)
         lib (second (re-find (re-pattern "[(]def lib '(\\S+)[)]")
                              (slurp "build.clj")))]
     (if tag
       ;; Rewrites the deps.edn and Leiningen coordinates in the Setup section
       (let [version (str/replace tag (re-pattern "^v") "")
             q       (java.util.regex.Pattern/quote lib)]
         (spit "README.md"
               (-> (slurp "README.md")
                   (str/replace (re-pattern (str "(" q " [{]:mvn/version \")[^\"]+(\"[}])"))
                                (str "$1" version "$2"))
                   (str/replace (re-pattern (str "([\\[]" q " \")[^\"]+(\"[\\]])"))
                                (str "$1" version "$2"))))
         (println "Updated README.md to version" version))
       (println "No tags yet, so README.md is unchanged. Rerun after tagging a release.")))}

  docs:git-deps
  {:doc      "Regenerate docs/git-deps.md from the latest tag.
              Uses HEAD if there are no tags yet."
   :requires ([babashka.process :as p]
              [clojure.string :as str])
   :task
   (let [sh      (fn [& args]
                   (-> (apply p/shell {:out :string :err :string :continue true} args)
                       :out
                       str/trim))
         tag     (not-empty (sh "git describe --tags --abbrev=0"))
         sha     (sh "git rev-list -n 1" (or tag "HEAD"))
         ;; git@github.com:owner/repo.git -> https://github.com/owner/repo
         url     (-> (sh "git remote get-url origin")
                     (str/replace (re-pattern "^git@github[.]com:") "https://github.com/")
                     (str/replace (re-pattern "[.]git$") ""))
         project (last (str/split url (re-pattern "/")))
         lib     (second (re-find (re-pattern "[(]def lib '(\\S+)[)]")
                                  (slurp "build.clj")))]
     (spit "docs/git-deps.md"
           (-> (slurp "docs/git-deps.template.md")
               (str/replace "{{PROJECT}}" project)
               (str/replace "{{LIB}}" lib)
               (str/replace "{{URL}}" (str "\"" url "\""))
               (str/replace "{{TAG}}" (str "\"" (or tag "<no tag yet>") "\""))
               (str/replace "{{SHA}}" (str "\"" sha "\""))))
     (when-not tag
       (println "No tags yet, so the SHA is from HEAD. Rerun after tagging a release."))
     (println "Wrote docs/git-deps.md for" (or tag "HEAD") sha))}}}
