{:paths ["src"]
 ;; No runtime dependencies. Clojure comes from the clojure CLI's defaults
 ;; for the build and test aliases, and from the consumer's own setup.
 :deps  {}
 :aliases
 {;; Latest ClojureScript, used by `bb test:advanced`
  :cljs-latest {:extra-paths ["test"]
                :extra-deps  {org.clojure/clojurescript {:mvn/version "1.12.145"}}}
  ;; Oldest supported ClojureScript, used by `bb test:compat`. This compiler
  ;; needs Clojure 1.8 (under 1.9 it emits ##Inf, which Closure cannot parse)
  ;; and, on Java 11+, the jaxb-api jar.
  :cljs-1.9    {:extra-paths   ["test"]
                :extra-deps    {org.clojure/clojurescript {:mvn/version "1.9.854"}
                                javax.xml.bind/jaxb-api   {:mvn/version "2.3.1"}}
                :override-deps {org.clojure/clojure {:mvn/version "1.8.0"}}}
  :build       {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                             slipset/deps-deploy           {:mvn/version "0.2.5"}}
                :ns-default build}}}
